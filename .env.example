# Copy to .env and fill in your Vertex AI project.
# Scripts load this via python-dotenv from the repo root.

GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Batch runners upload JSONL to GCS and read predictions back.
# Override with --bucket on each script if you use a different bucket.
# DEFAULT_BUCKET=agenttracebucket
